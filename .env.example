# Required
ANTHROPIC_API_KEY=your-api-key-here  # Format: sk-ant-api03-...
PERPLEXITY_API_KEY=pplx-abcde # For research (recommended but optional)

# Optional - defaults shown
MODEL=claude-3-7-sonnet-20250219  # Recommended models: claude-3-7-sonnet-20250219, claude-3-opus-20240229
PERPLEXITY_MODEL=sonar-pro        # Make sure you have access to sonar-pro otherwise you can use sonar regular.
MAX_TOKENS=4000                   # Maximum tokens for model responses
TEMPERATURE=0.7                   # Temperature for model responses (0.0-1.0)
DEBUG=false                       # Enable debug logging (true/false)
LOG_LEVEL=info                    # Log level (debug, info, warn, error)
DEFAULT_SUBTASKS=3                # Default number of subtasks when expanding
DEFAULT_PRIORITY=medium           # Default priority for generated tasks (high, medium, low)
PROJECT_NAME=Desktop-Eletron-Widget      # Project name for tasks.json metadata

# App Configuration
APP_NAME=URLWidgets
APP_VERSION=1.0.0
APP_DESCRIPTION="Desktop widget application for embedding web content"
APP_AUTHOR="Your Name"

# Code Signing
# For macOS code signing
APPLE_ID=your.apple.id@example.com
APPLE_ID_PASSWORD=your-app-specific-password  # Generate from Apple ID settings
APPLE_TEAM_ID=XXXXXXXXXX  # Found in your Apple Developer account
CSC_LINK=path/to/certificate.p12  # Your Developer ID Application certificate
CSC_KEY_PASSWORD=your-certificate-password

# For Windows code signing
WINDOWS_CERTIFICATE_FILE=path/to/windows-cert.pfx
WINDOWS_CERTIFICATE_PASSWORD=your-windows-cert-password

# Auto Updates (GitHub)
GH_TOKEN=your-github-token  # Personal access token with repo scope
GITHUB_OWNER=your-github-username
GITHUB_REPO=URLWidgets

# Development
NODE_ENV=development  # Change to 'production' for production builds
DEBUG=electron-builder  # Remove for production builds

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual values
# 3. For code signing:
#    - macOS: Get Developer ID certificate from Apple Developer account
#    - Windows: Get code signing certificate from a Certificate Authority
# 4. For auto-updates:
#    - Create a GitHub personal access token with repo scope
#    - Set up a GitHub repository for releases