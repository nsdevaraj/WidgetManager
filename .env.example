# App Configuration
APP_NAME=Widget Desktop
APP_VERSION=1.0.0
APP_DESCRIPTION="Desktop widget application for embedding web content"
APP_AUTHOR="Devaraj NS"

# Code Signing
# For macOS code signing
APPLE_ID=nsdevaraj@gmail.com
APPLE_ID_PASSWORD=your-app-specific-password  # Generate from Apple ID settings
APPLE_TEAM_ID=XXXXXXXXXX  # Found in your Apple Developer account
CSC_LINK=path/to/certificate.p12  # Your Developer ID Application certificate
CSC_KEY_PASSWORD=your-certificate-password

# For Windows code signing
WINDOWS_CERTIFICATE_FILE=path/to/windows-cert.pfx
WINDOWS_CERTIFICATE_PASSWORD=your-windows-cert-password

# Auto Updates (GitHub)
GH_TOKEN=your-github-token  # Personal access token with repo scope
GITHUB_OWNER=nsdevaraj
GITHUB_REPO=WidgetManager

# Development
NODE_ENV=production  # Change to 'production' for production builds
#DEBUG=electron-builder  # Remove for production builds

# Analytics & Error Reporting
SENTRY_DSN=your_sentry_dsn_here
MIXPANEL_TOKEN=your_mixpanel_token_here

# License Management
LICENSE_SERVER_URL=https://api.your-license-server.com
LICENSE_SERVER_KEY=your_license_server_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual values
# 3. For code signing:
#    - macOS: Get Developer ID certificate from Apple Developer account
#    - Windows: Get code signing certificate from a Certificate Authority
# 4. For auto-updates:
#    - Create a GitHub personal access token with repo scope
#    - Set up a GitHub repository for releases